APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jarvis
DB_USERNAME=root
DB_PASSWORD=

# AI Provider
# 'local' = mode demo tanpa API key | 'nine_router' = gateway 9Router
AI_PROVIDER=local
# Catatan: nama env HARUS diawali huruf/underscore (bukan angka) agar terbaca
# oleh PHP built-in server (php artisan serve).
NINE_ROUTER_BASE_URL=
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=
NINE_ROUTER_FALLBACK_MODEL=
NINE_ROUTER_TIMEOUT=120

# Agent internet (tool-calling web search via Bing/Wikipedia, tanpa API key)
JARVIS_AGENT_ENABLED=true
JARVIS_AGENT_MAX_ROUNDS=3

# Hermes (execution/agent layer — komunikasi server-side saja)
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_TIMEOUT=30

# TTS suara JARVIS
# engine: auto = Edge TTS gratis (tanpa API key)
JARVIS_TTS_ENGINE=auto

# XTTS voice clone JARVIS Master (hanya untuk PC lokal ber-GPU, bukan VPS)
# Jalankan ai\start_xtts_server.bat agar cloning aktif & cepat (±3-5 dtk).
XTTS_ENABLED=false
XTTS_SERVER_URL=http://127.0.0.1:8012
XTTS_PYTHON=c:/laragon/www/jarvis/ai/venv/Scripts/python.exe
XTTS_TIMEOUT=120

FRONTEND_URL=http://localhost:5173

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
